# Supabase (public/publishable keys only) — use VITE_ prefix (Vite app, not Next.js)
# Cloud save/sync only runs on production builds (Vercel, Netlify). Local npm run dev uses browser storage.
# Copy to .env.local and fill in values from the Supabase project settings. Never commit .env.local.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
